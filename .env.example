APP_PORT=8080
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
MIGRATIONS_PATH=migrations

DB_HOST=postgres
DB_PORT=5432
DB_USER=habit
DB_PASSWORD=habit_secret
DB_NAME=habit_tracker
DB_SSLMODE=disable

# CORS для веб-фронта (через запятую). Пусто = localhost:3000 и :5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (token bucket по IP). false = отключить (локальная отладка)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_AUTH_BURST=3
RATE_LIMIT_API_RPM=120
RATE_LIMIT_API_BURST=30

# Автоудаление из архива (hard delete) через N дней после soft delete
ARCHIVE_PURGE_ENABLED=true
ARCHIVE_PURGE_DAYS=7
ARCHIVE_PURGE_INTERVAL=24h
