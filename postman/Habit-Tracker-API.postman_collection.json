{
	"info": {
		"_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
		"name": "Habit Tracker API",
		"description": "REST API трекера привычек (дипломный MVP).\n\n**Импорт:** File → Import → выберите этот файл и `Habit-Tracker-Local.postman_environment.json`.\n\n**Порядок:** Health → Register (или Login) → остальные запросы в Habits.\n\nПосле Register/Login токен сохраняется в переменную `token`. После Create Habit — `habitId`.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						},
						"description": "Проверка, что API запущен."
					},
					"response": []
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"const json = pm.response.json();",
									"if (json.token) {",
									"    pm.environment.set('token', json.token);",
									"    console.log('token saved to environment');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Регистрация. При успехе сохраняет JWT в `token`."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const json = pm.response.json();",
									"if (json.token) {",
									"    pm.environment.set('token', json.token);",
									"    console.log('token saved to environment');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Вход. При успехе сохраняет JWT в `token`."
					},
					"response": []
				},
				{
					"name": "Get Me (profile)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const json = pm.response.json();",
									"pm.test('Has gamification fields', function () {",
									"    pm.expect(json).to.have.property('xp');",
									"    pm.expect(json).to.have.property('level');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "me"]
						},
						"description": "Профиль: email, xp, level. Нужен JWT."
					},
					"response": []
				},
				{
					"name": "Get Achievements",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/achievements",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "achievements"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Habits",
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{token}}",
						"type": "string"
					}
				]
			},
			"item": [
				{
					"name": "List Habits",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/habits",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "habits"]
						},
						"description": "Все привычки пользователя."
					},
					"response": []
				},
				{
					"name": "List Habits (today)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/habits?today=true",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "habits"],
							"query": [
								{
									"key": "today",
									"value": "true"
								}
							]
						},
						"description": "Привычки на сегодня: daily всегда; weekly — в свой день недели; без уже выполненных сегодня check-in."
					},
					"response": []
				},
				{
					"name": "Create Habit",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"const json = pm.response.json();",
									"if (json.id) {",
									"    pm.environment.set('habitId', String(json.id));",
									"    console.log('habitId saved:', json.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Читать 30 минут\",\n  \"description\": \"Каждый день перед сном\",\n  \"frequency\": \"daily\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/habits",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "habits"]
						}
					},
					"response": []
				},
				{
					"name": "Get Habit by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/habits/{{habitId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "habits", "{{habitId}}"]
						}
					},
					"response": []
				},
				{
					"name": "Update Habit",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Читать 45 минут\",\n  \"description\": \"Обновлённое описание\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/habits/{{habitId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "habits", "{{habitId}}"]
						}
					},
					"response": []
				},
				{
					"name": "Check-in (today)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/habits/{{habitId}}/check-ins",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "habits", "{{habitId}}", "check-ins"]
						},
						"description": "Пустое тело — отметка на сегодня (UTC)."
					},
					"response": []
				},
				{
					"name": "Check-in (specific date)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"date\": \"{{checkInDate}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/habits/{{habitId}}/check-ins",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "habits", "{{habitId}}", "check-ins"]
						},
						"description": "Укажите `checkInDate` в environment (YYYY-MM-DD), например 2026-05-19."
					},
					"response": []
				},
				{
					"name": "Check-in Duplicate (expect 409)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 409 Conflict', function () {",
									"    pm.response.to.have.status(409);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/habits/{{habitId}}/check-ins",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "habits", "{{habitId}}", "check-ins"]
						},
						"description": "Запустите после Check-in (today) — ожидается конфликт."
					},
					"response": []
				},
				{
					"name": "Habit Stats",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const json = pm.response.json();",
									"pm.test('Has streak fields', function () {",
									"    pm.expect(json).to.have.property('total_check_ins');",
									"    pm.expect(json).to.have.property('current_streak');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/habits/{{habitId}}/stats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "habits", "{{habitId}}", "stats"]
						}
					},
					"response": []
				},
				{
					"name": "Delete Habit",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}{{apiPrefix}}/habits/{{habitId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "habits", "{{habitId}}"]
						},
						"description": "204 No Content. Запускайте в конце сценария."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "apiPrefix",
			"value": "/api/v1"
		}
	]
}
